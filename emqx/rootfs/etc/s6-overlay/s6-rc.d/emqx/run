#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community Add-on: EMQX
# Runs the EMQX broker
# ==============================================================================
readonly node_cookie_file="/data/emqx/node.cookie"

bashio::log.info 'Starting EMQX...'

# The Erlang cookie guards access to the node's distribution port, and this
# add-on runs with host networking, so that port is reachable from the LAN.
# A cookie derived from the hostname is guessable, so a random one is drawn
# once per installation and kept in /data. Set EMQX_NODE__COOKIE through the
# env_vars option to use a specific cookie instead (e.g. for clustering).
if [ -s "${node_cookie_file}" ]; then
    node_cookie=$(cat "${node_cookie_file}")
else
    node_cookie=$(od -vAn -tx1 -N32 /dev/urandom | tr -d ' \n')
    (umask 077 && printf '%s' "${node_cookie}" > "${node_cookie_file}")
fi

export EMQX_HOST=$(bashio::info.hostname)
export EMQX_NAME="emqx"
export EMQX_NODE__COOKIE="${node_cookie}"
export EMQX_NODE__DATA_DIR="/data/emqx/data"
export EMQX_NODE__ETC_DIR="/data/emqx/etc"
export EMQX_NODE__NAME="${EMQX_NAME}@${EMQX_HOST}.local"
export EMQX_PLUGINS__INSTALL_DIR="/data/emqx/plugins"
export EMQX_RPC__PORT_DISCOVERY="manual"
export EMQX_LOG_DIR="/data/emqx/log"

# Map Home Assistant configuration options to EMQX environment variables
if bashio::config.has_value 'default_admin_password'; then
    export EMQX_DASHBOARD__DEFAULT_PASSWORD=$(bashio::config 'default_admin_password')
fi

if bashio::config.has_value 'mqtt_port'; then
    export EMQX_LISTENERS__TCP__DEFAULT__BIND="0.0.0.0:$(bashio::config 'mqtt_port')"
fi

if bashio::config.has_value 'mqtts_port'; then
    export EMQX_LISTENERS__SSL__DEFAULT__BIND="0.0.0.0:$(bashio::config 'mqtts_port')"
fi

if bashio::config.has_value 'websocket_port'; then
    export EMQX_LISTENERS__WS__DEFAULT__BIND="0.0.0.0:$(bashio::config 'websocket_port')"
fi

if bashio::config.has_value 'wss_port'; then
    export EMQX_LISTENERS__WSS__DEFAULT__BIND="0.0.0.0:$(bashio::config 'wss_port')"
fi

if bashio::config.has_value 'log_level'; then
    export EMQX_LOG__CONSOLE__LEVEL=$(bashio::config 'log_level')
fi

if bashio::config.has_value 'ssl_certfile'; then
    certfile=$(bashio::config 'ssl_certfile')
    if [ -n "${certfile}" ] && [ -f "${certfile}" ]; then
        export EMQX_LISTENERS__SSL__DEFAULT__SSL_OPTIONS__CERTFILE="${certfile}"
    fi
fi

if bashio::config.has_value 'ssl_keyfile'; then
    keyfile=$(bashio::config 'ssl_keyfile')
    if [ -n "${keyfile}" ] && [ -f "${keyfile}" ]; then
        export EMQX_LISTENERS__SSL__DEFAULT__SSL_OPTIONS__KEYFILE="${keyfile}"
    fi
fi

if bashio::config.has_value 'ssl_cacertfile'; then
    cacertfile=$(bashio::config 'ssl_cacertfile')
    if [ -n "${cacertfile}" ] && [ -f "${cacertfile}" ]; then
        export EMQX_LISTENERS__SSL__DEFAULT__SSL_OPTIONS__CACERTFILE="${cacertfile}"
    fi
fi

if bashio::config.has_value 'telemetry_enable'; then
    export EMQX_TELEMETRY__ENABLE=$(bashio::config 'telemetry_enable')
fi

if bashio::config.has_value 'max_packet_size'; then
    export EMQX_MQTT__MAX_PACKET_SIZE=$(bashio::config 'max_packet_size')
fi

# Retainer storage backend.
# NOTE: this deviates from upstream EMQX. EMQX's own default is "ram", which
# keeps retained messages in memory only and loses them on every broker
# restart. This add-on defaults the option to "disc" instead, so retained
# messages persist across restarts via the built-in RocksDB store under /data.
# Set the option to "ram" to restore the upstream EMQX behaviour.
if bashio::config.has_value 'retainer_storage_type'; then
    export EMQX_RETAINER__BACKEND__STORAGE_TYPE=$(bashio::config 'retainer_storage_type')
fi

# Retainer delivery / publish rate limits.
# NOTE: this deviates from upstream EMQX. EMQX defaults both retainer rates to
# "1000/s", which drops retained messages when a wildcard subscription (e.g.
# Home Assistant discovery subscribing to homeassistant/+/+/config) needs a
# large burst delivered at once. This add-on raises both defaults to "100000/s"
# so retained delivery and publishing are effectively unthrottled for typical
# home setups. Lower them to "1000/s" to restore the upstream EMQX behaviour.
if bashio::config.has_value 'retainer_delivery_rate'; then
    export EMQX_RETAINER__DELIVERY_RATE=$(bashio::config 'retainer_delivery_rate')
fi

if bashio::config.has_value 'retainer_max_publish_rate'; then
    export EMQX_RETAINER__MAX_PUBLISH_RATE=$(bashio::config 'retainer_max_publish_rate')
fi

# Load custom environment variables.
# Only the name is logged: values may hold secrets (passwords, cookies, keys).
for var in $(bashio::config 'env_vars|keys'); do
    name=$(bashio::config "env_vars[${var}].name")
    value=$(bashio::config "env_vars[${var}].value")
    bashio::log.info "Setting ${name}"
    export "${name}=${value}"
done

# Set max open file limit to avoid memory allocation issues
if [ "$(ulimit -Hn)" -gt 524288 ]; then
    ulimit -n 524288
fi

# Run EMQX
exec /opt/emqx/bin/emqx foreground
